<UserControl x:Class="BB84.IPTV.M3U.Editor.Controls.PlaylistControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:BB84.IPTV.M3U.Editor.Domain.Enumerators;assembly=BB84.IPTV.M3U.Editor.Domain">
	<UserControl.Resources>
		<ObjectDataProvider x:Key="DeinterlaceValues" MethodName="GetValues" ObjectType="{x:Type domain:Deinterlace}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="domain:Deinterlace"/>
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
	</UserControl.Resources>

	<DockPanel>
		<!-- Toolbar -->
		<ToolBar DockPanel.Dock="Top">
			<Button Content="Add" ToolTip="Add Entry"/>
			<Button Content="Duplicate" ToolTip="Duplicate Entry"/>
			<Button Content="Remove" ToolTip="Remove Entry"/>
			<Button Content="Move Up" ToolTip="Move Entry Up"/>
			<Button Content="Move Down" ToolTip="Move Entry Down"/>
		</ToolBar>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Entries DataGrid -->
			<GroupBox Grid.Column="0" Header="Entries" Margin="4">
				<DataGrid x:Name="entriesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
									SelectionMode="Single" SelectionChanged="EntriesDataGrid_SelectionChanged"
									ItemsSource="{Binding Entries}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
						<DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
						<DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="*"/>
						<DataGridTextColumn Header="Grouping" Binding="{Binding Grouping}" Width="120"/>
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>

			<!-- Detail Panel -->
			<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Width="320">
				<StackPanel Margin="4">
					<!-- Playlist Header -->
					<GroupBox Header="Playlist">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock x:Name="filePathLabel" Grid.Row="0" Grid.Column="0" Text="File Path:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="tvGuidePathLabel" Grid.Row="1" Grid.Column="0" Text="TV Guide:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UrlTvg, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="cacheLabel" Grid.Row="2" Grid.Column="0" Text="Cache:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Cache, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="deinterlaceLabel" Grid.Row="3" Grid.Column="0" Text="Deinterlace:" Margin="4" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Source={StaticResource DeinterlaceValues}}"
												SelectedItem="{Binding Deinterlace}" Margin="4"/>

							<TextBlock x:Name="refreshLabel" Grid.Row="4" Grid.Column="0" Text="Refresh:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Refresh, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
						</Grid>
					</GroupBox>

					<!-- Entry Detail -->
					<GroupBox Header="Entry" Visibility="{Binding SelectedEntryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
						<Grid DataContext="{Binding SelectedEntry}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock x:Name="trackDurationLabel" Grid.Row="0" Grid.Column="0" Text="Duration:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="trackTitleLabel" Grid.Row="1" Grid.Column="0" Text="Title:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="trackLocationLabel" Grid.Row="2" Grid.Column="0" Text="Location:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="trackGroupingLabel" Grid.Row="3" Grid.Column="0" Text="Grouping:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Grouping, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
						</Grid>
					</GroupBox>

					<!-- Metadata Detail -->
					<GroupBox Header="Metadata" Visibility="{Binding SelectedEntryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
						<Grid DataContext="{Binding SelectedEntry.Metadata}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Grid.Column="0" Text="Identifier:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="metadataNameLabel" Grid.Row="1" Grid.Column="0" Text="Name:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="metadataLogoLabel" Grid.Row="2" Grid.Column="0" Text="Logo:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Logo, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="metadataGroupIdLabel" Grid.Row="3" Grid.Column="0" Text="Group ID:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<TextBlock x:Name="metadataGroupTitleLabel" Grid.Row="4" Grid.Column="0" Text="Group Title:" Margin="4" VerticalAlignment="Center"/>
							<TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GroupTitle, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>

							<CheckBox x:Name="metadataCensoredCheckBox" Grid.Row="5" Grid.ColumnSpan="2" Content="Censored" Margin="4"
												IsChecked="{Binding Censored}"/>
						</Grid>
					</GroupBox>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</UserControl>
