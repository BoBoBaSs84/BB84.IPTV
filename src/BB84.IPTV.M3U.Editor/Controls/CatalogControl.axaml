<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
						 xmlns:conv="using:BB84.IPTV.M3U.Editor.Converters"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="1200"
						 d:DesignHeight="700"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.CatalogControl"
						 x:DataType="vm:CatalogViewModel">
	<UserControl.Styles>
		<Style Selector="Grid.Detail > TextBlock">
			<Setter Property="Margin"
							Value="4" />
			<Setter Property="VerticalAlignment"
							Value="Center" />
		</Style>
		<Style Selector="Grid.Detail > TextBox">
			<Setter Property="Margin"
							Value="4" />
		</Style>
	</UserControl.Styles>
	<TabControl Margin="4">
		<!-- The iptv-org catalog -->
		<TabItem Header="{x:Static p:Resources.CatalogControl_CatalogTabItem_Header}">
			<DockPanel>
				<!-- Filter -->
				<HeaderedContentControl DockPanel.Dock="Top"
																Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.CatalogControl_FilterGroupBox_Header}"
																Margin="4">
					<StackPanel Spacing="4">
						<WrapPanel>
							<TextBox PlaceholderText="{x:Static p:Resources.CatalogControl_SearchTextBox_Placeholder}"
											 Width="220"
											 Margin="4"
											 Text="{Binding SearchText}" />
							<ComboBox PlaceholderText="{x:Static p:Resources.CatalogControl_CountryComboBox_Placeholder}"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Countries}"
												SelectedItem="{Binding SelectedCountry}" />
							<ComboBox PlaceholderText="{x:Static p:Resources.CatalogControl_LanguageComboBox_Placeholder}"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Languages}"
												SelectedItem="{Binding SelectedLanguage}" />
							<ComboBox PlaceholderText="{x:Static p:Resources.CatalogControl_CategoryComboBox_Placeholder}"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Categories}"
												SelectedItem="{Binding SelectedCategory}" />
							<CheckBox Content="{x:Static p:Resources.CatalogControl_IncludeNsfwCheckBox_Content}"
												Margin="4"
												IsChecked="{Binding IncludeNsfw}" />
							<CheckBox Content="{x:Static p:Resources.CatalogControl_IncludeWithoutStreamCheckBox_Content}"
												Margin="4"
												IsChecked="{Binding IncludeWithoutStream}" />
							<Button Content="{x:Static p:Resources.CatalogControl_SearchButton_Content}"
											Margin="4"
											Command="{Binding SearchCommand}" />
							<Button Content="{x:Static p:Resources.CatalogControl_ResetButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.CatalogControl_ResetButton_ToolTip}"
											Margin="4"
											Command="{Binding ResetFiltersCommand}" />
						</WrapPanel>
						<TextBlock Text="{Binding ResultMessage}"
											 Foreground="#888"
											 Margin="4,0"
											 TextWrapping="Wrap"
											 IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</StackPanel>
				</HeaderedContentControl>

				<!-- Commands -->
				<StackPanel DockPanel.Dock="Bottom"
										Orientation="Horizontal"
										Spacing="4"
										Margin="4">
					<Button Content="{x:Static p:Resources.CatalogControl_AddChannelButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.CatalogControl_AddChannelButton_ToolTip}"
									Command="{Binding AddChannelCommand}" />
					<Button Content="{x:Static p:Resources.CatalogControl_AddAllChannelsButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.CatalogControl_AddAllChannelsButton_ToolTip}"
									Command="{Binding AddAllChannelsCommand}" />
					<Button Content="{x:Static p:Resources.CatalogControl_PreviousPageButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.Common_PreviousPage_ToolTip}"
									Margin="12,0,0,0"
									Command="{Binding PreviousPageCommand}" />
					<Button Content="{x:Static p:Resources.CatalogControl_NextPageButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.Common_NextPage_ToolTip}"
									Command="{Binding NextPageCommand}" />
					<TextBlock Text="{x:Static p:Resources.CatalogControl_NoPlaylistHint_Text}"
										 Foreground="#888"
										 VerticalAlignment="Center"
										 Margin="8,0,0,0"
										 IsVisible="{Binding !Editor.HasPlaylist}" />
				</StackPanel>

				<!-- Result -->
				<HeaderedContentControl Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.CatalogControl_ChannelsGroupBox_Header}"
																Margin="4">
					<DataGrid AutoGenerateColumns="False"
										IsReadOnly="True"
										SelectionMode="Single"
										GridLinesVisibility="All"
										ItemsSource="{Binding Channels}"
										SelectedItem="{Binding SelectedChannel}">
						<DataGrid.Columns>
							<!-- Only cached logos are shown, a missing one stays empty. -->
							<DataGridTemplateColumn Header="{x:Static p:Resources.CatalogControl_LogoColumn_Header}"
																			CanUserSort="False"
																			Width="56">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate x:DataType="vm:CatalogChannelViewModel">
										<Image Source="{Binding LogoUrl, Converter={x:Static conv:LogoImageConverter.Instance}}"
													 Height="32"
													 Width="48"
													 Stretch="Uniform"
													 Margin="2" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_NameColumn_Header}"
																	Binding="{Binding Name}"
																	Width="2*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_TvgIdColumn_Header}"
																	Binding="{Binding TvgId}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_CountryColumn_Header}"
																	Binding="{Binding Country}"
																	Width="80" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_LanguagesColumn_Header}"
																	Binding="{Binding Languages}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_CategoriesColumn_Header}"
																	Binding="{Binding Categories}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_QualityColumn_Header}"
																	Binding="{Binding Quality}"
																	Width="80" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="{x:Static p:Resources.CatalogControl_StreamColumn_Header}"
																	Binding="{Binding StreamUrl}"
																	Width="2*" />
						</DataGrid.Columns>
					</DataGrid>
				</HeaderedContentControl>
			</DockPanel>
		</TabItem>

		<!-- User defined channels -->
		<TabItem Header="{x:Static p:Resources.CatalogControl_CustomChannelsTabItem_Header}">
			<Grid ColumnDefinitions="280,*">
				<HeaderedContentControl Grid.Column="0"
																Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.CatalogControl_ChannelsGroupBox_Header}"
																Margin="4">
					<DockPanel>
						<!-- Only shown when the custom channels do not fit on one page. -->
						<DockPanel DockPanel.Dock="Bottom"
											 Margin="0,4,0,0"
											 IsVisible="{Binding HasMultipleCustomChannelPages}">
							<Button DockPanel.Dock="Left"
											Content="&lt;"
											ToolTip.Tip="{x:Static p:Resources.Common_PreviousPage_ToolTip}"
											Margin="2"
											Command="{Binding PreviousCustomChannelPageCommand}" />
							<Button DockPanel.Dock="Right"
											Content="&gt;"
											ToolTip.Tip="{x:Static p:Resources.Common_NextPage_ToolTip}"
											Margin="2"
											Command="{Binding NextCustomChannelPageCommand}" />
							<TextBlock Text="{Binding CustomChannelPageStatus}"
												 Foreground="#888"
												 HorizontalAlignment="Center"
												 VerticalAlignment="Center" />
						</DockPanel>
						<UniformGrid DockPanel.Dock="Bottom"
												 Columns="2"
												 Margin="0,4,0,0">
							<Button Content="{x:Static p:Resources.CatalogControl_NewCustomChannelButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.CatalogControl_NewCustomChannelButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding NewCustomChannelCommand}" />
							<Button Content="{x:Static p:Resources.CatalogControl_SaveCustomChannelButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.CatalogControl_SaveCustomChannelButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding SaveCustomChannelCommand}" />
							<Button Content="{x:Static p:Resources.CatalogControl_DeleteCustomChannelButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.CatalogControl_DeleteCustomChannelButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding DeleteCustomChannelCommand}" />
							<Button Content="{x:Static p:Resources.CatalogControl_AddChannelButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.CatalogControl_AddCustomChannelButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding AddCustomChannelCommand}" />
						</UniformGrid>
						<ListBox ItemsSource="{Binding CustomChannels}"
										 SelectionMode="Single"
										 SelectedItem="{Binding SelectedCustomChannel}">
							<ListBox.Styles>
								<!-- Screen readers announce the channel name instead of the view model type. -->
								<Style Selector="ListBoxItem"
											 x:DataType="vm:CustomChannelViewModel">
									<Setter Property="AutomationProperties.Name"
													Value="{Binding Name}" />
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:CustomChannelViewModel">
									<StackPanel>
										<TextBlock Text="{Binding Name}"
															 FontWeight="SemiBold"
															 TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Url}"
															 FontSize="12"
															 Foreground="#888"
															 TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</HeaderedContentControl>

				<!-- Detail of the selected custom channel -->
				<HeaderedContentControl Grid.Column="1"
																Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.CatalogControl_ChannelGroupBox_Header}"
																VerticalAlignment="Top"
																Margin="4"
																IsVisible="{Binding SelectedCustomChannelVisible}">
					<Grid Classes="Detail"
								DataContext="{Binding SelectedCustomChannel}"
								x:DataType="vm:CustomChannelViewModel"
								ColumnDefinitions="Auto,*"
								RowDefinitions="Auto,Auto,Auto,Auto,Auto">
						<TextBlock Grid.Row="0"
											 Text="{x:Static p:Resources.CatalogControl_NameTextBlock_Text}" />
						<TextBox Grid.Row="0"
										 Grid.Column="1"
										 Text="{Binding Name}" />

						<TextBlock Grid.Row="1"
											 Text="{x:Static p:Resources.CatalogControl_UrlTextBlock_Text}"
											 ToolTip.Tip="{x:Static p:Resources.CatalogControl_UrlTextBlock_ToolTip}" />
						<TextBox Grid.Row="1"
										 Grid.Column="1"
										 PlaceholderText="rtsp://192.168.12.1:554"
										 Text="{Binding Url}" />

						<TextBlock Grid.Row="2"
											 Text="{x:Static p:Resources.CatalogControl_GroupTitleTextBlock_Text}" />
						<TextBox Grid.Row="2"
										 Grid.Column="1"
										 Text="{Binding GroupTitle}" />

						<TextBlock Grid.Row="3"
											 Text="{x:Static p:Resources.CatalogControl_TvgIdTextBlock_Text}" />
						<TextBox Grid.Row="3"
										 Grid.Column="1"
										 Text="{Binding TvgId}" />

						<TextBlock Grid.Row="4"
											 Text="{x:Static p:Resources.CatalogControl_TvgLogoTextBlock_Text}" />
						<TextBox Grid.Row="4"
										 Grid.Column="1"
										 Text="{Binding TvgLogo}" />
					</Grid>
				</HeaderedContentControl>
			</Grid>
		</TabItem>
	</TabControl>
</UserControl>
