<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="1200"
						 d:DesignHeight="700"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.CatalogControl"
						 x:DataType="vm:CatalogViewModel">
	<UserControl.Styles>
		<Style Selector="Grid.Detail > TextBlock">
			<Setter Property="Margin"
							Value="4" />
			<Setter Property="VerticalAlignment"
							Value="Center" />
		</Style>
		<Style Selector="Grid.Detail > TextBox">
			<Setter Property="Margin"
							Value="4" />
		</Style>
	</UserControl.Styles>
	<TabControl Margin="4">
		<!-- The iptv-org catalog -->
		<TabItem Header="Catalog">
			<DockPanel>
				<!-- Filter -->
				<HeaderedContentControl DockPanel.Dock="Top"
																Theme="{StaticResource GroupBox}"
																Header="Filter"
																Margin="4">
					<StackPanel Spacing="4">
						<WrapPanel>
							<TextBox PlaceholderText="Name or identifier"
											 Width="220"
											 Margin="4"
											 Text="{Binding SearchText}" />
							<ComboBox PlaceholderText="Country"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Countries}"
												SelectedItem="{Binding SelectedCountry}" />
							<ComboBox PlaceholderText="Language"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Languages}"
												SelectedItem="{Binding SelectedLanguage}" />
							<ComboBox PlaceholderText="Category"
												Width="180"
												Margin="4"
												ItemsSource="{Binding Categories}"
												SelectedItem="{Binding SelectedCategory}" />
							<CheckBox Content="Include NSFW"
												Margin="4"
												IsChecked="{Binding IncludeNsfw}" />
							<CheckBox Content="Include channels without stream"
												Margin="4"
												IsChecked="{Binding IncludeWithoutStream}" />
							<Button Content="Search"
											Margin="4"
											Command="{Binding SearchCommand}" />
							<Button Content="Reset"
											ToolTip.Tip="Clear the filter and the result"
											Margin="4"
											Command="{Binding ResetFiltersCommand}" />
						</WrapPanel>
						<TextBlock Text="{Binding ResultMessage}"
											 Foreground="#888"
											 Margin="4,0"
											 TextWrapping="Wrap"
											 IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
					</StackPanel>
				</HeaderedContentControl>

				<!-- Commands -->
				<StackPanel DockPanel.Dock="Bottom"
										Orientation="Horizontal"
										Spacing="4"
										Margin="4">
					<Button Content="Add to Playlist"
									ToolTip.Tip="Add the selected channel to the open playlist"
									Command="{Binding AddChannelCommand}" />
					<Button Content="Add All"
									ToolTip.Tip="Add all found channels to the open playlist"
									Command="{Binding AddAllChannelsCommand}" />
					<TextBlock Text="Open a playlist to add channels to it."
										 Foreground="#888"
										 VerticalAlignment="Center"
										 Margin="8,0,0,0"
										 IsVisible="{Binding !Editor.HasPlaylist}" />
				</StackPanel>

				<!-- Result -->
				<HeaderedContentControl Theme="{StaticResource GroupBox}"
																Header="Channels"
																Margin="4">
					<DataGrid AutoGenerateColumns="False"
										IsReadOnly="True"
										CanUserSortColumns="True"
										SelectionMode="Single"
										GridLinesVisibility="All"
										ItemsSource="{Binding Channels}"
										SelectedItem="{Binding SelectedChannel}">
						<DataGrid.Columns>
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Name"
																	Binding="{Binding Name}"
																	Width="2*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="TVG ID"
																	Binding="{Binding TvgId}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Country"
																	Binding="{Binding Country}"
																	Width="80" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Languages"
																	Binding="{Binding Languages}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Categories"
																	Binding="{Binding Categories}"
																	Width="*" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Quality"
																	Binding="{Binding Quality}"
																	Width="80" />
							<DataGridTextColumn x:DataType="vm:CatalogChannelViewModel"
																	Header="Stream"
																	Binding="{Binding StreamUrl}"
																	Width="2*" />
						</DataGrid.Columns>
					</DataGrid>
				</HeaderedContentControl>
			</DockPanel>
		</TabItem>

		<!-- User defined channels -->
		<TabItem Header="Custom Channels">
			<Grid ColumnDefinitions="280,*">
				<HeaderedContentControl Grid.Column="0"
																Theme="{StaticResource GroupBox}"
																Header="Channels"
																Margin="4">
					<DockPanel>
						<UniformGrid DockPanel.Dock="Bottom"
												 Columns="2"
												 Margin="0,4,0,0">
							<Button Content="New"
											ToolTip.Tip="Create a new custom channel"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding NewCustomChannelCommand}" />
							<Button Content="Save"
											ToolTip.Tip="Store the selected custom channel"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding SaveCustomChannelCommand}" />
							<Button Content="Delete"
											ToolTip.Tip="Delete the selected custom channel"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding DeleteCustomChannelCommand}" />
							<Button Content="Add to Playlist"
											ToolTip.Tip="Add the selected custom channel to the open playlist"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding AddCustomChannelCommand}" />
						</UniformGrid>
						<ListBox ItemsSource="{Binding CustomChannels}"
										 SelectionMode="Single"
										 SelectedItem="{Binding SelectedCustomChannel}">
							<ListBox.Styles>
								<!-- Screen readers announce the channel name instead of the view model type. -->
								<Style Selector="ListBoxItem"
											 x:DataType="vm:CustomChannelViewModel">
									<Setter Property="AutomationProperties.Name"
													Value="{Binding Name}" />
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:CustomChannelViewModel">
									<StackPanel>
										<TextBlock Text="{Binding Name}"
															 FontWeight="SemiBold"
															 TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Url}"
															 FontSize="12"
															 Foreground="#888"
															 TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</HeaderedContentControl>

				<!-- Detail of the selected custom channel -->
				<HeaderedContentControl Grid.Column="1"
																Theme="{StaticResource GroupBox}"
																Header="Channel"
																VerticalAlignment="Top"
																Margin="4"
																IsVisible="{Binding SelectedCustomChannelVisible}">
					<Grid Classes="Detail"
								DataContext="{Binding SelectedCustomChannel}"
								x:DataType="vm:CustomChannelViewModel"
								ColumnDefinitions="Auto,*"
								RowDefinitions="Auto,Auto,Auto,Auto,Auto">
						<TextBlock Grid.Row="0"
											 Text="Name:" />
						<TextBox Grid.Row="0"
										 Grid.Column="1"
										 Text="{Binding Name}" />

						<TextBlock Grid.Row="1"
											 Text="URL:"
											 ToolTip.Tip="Any URL scheme, e.g. http, https, rtsp or udp" />
						<TextBox Grid.Row="1"
										 Grid.Column="1"
										 PlaceholderText="rtsp://192.168.12.1:554"
										 Text="{Binding Url}" />

						<TextBlock Grid.Row="2"
											 Text="Group Title:" />
						<TextBox Grid.Row="2"
										 Grid.Column="1"
										 Text="{Binding GroupTitle}" />

						<TextBlock Grid.Row="3"
											 Text="TVG ID:" />
						<TextBox Grid.Row="3"
										 Grid.Column="1"
										 Text="{Binding TvgId}" />

						<TextBlock Grid.Row="4"
											 Text="TVG Logo:" />
						<TextBox Grid.Row="4"
										 Grid.Column="1"
										 Text="{Binding TvgLogo}" />
					</Grid>
				</HeaderedContentControl>
			</Grid>
		</TabItem>
	</TabControl>
</UserControl>
