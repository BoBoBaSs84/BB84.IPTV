<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:m="using:BB84.IPTV.M3U.Editor.Markup"
						 xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
						 xmlns:appEnums="using:BB84.IPTV.M3U.Editor.Application.Enumerators"
						 xmlns:logging="using:Microsoft.Extensions.Logging"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="800"
						 d:DesignHeight="450"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.SettingsControl"
						 x:DataType="vm:SettingsViewModel">
	<UserControl.Styles>
		<!-- Integer-only input with group separators, replaces the WPF IntegerTextBoxBehavior. -->
		<Style Selector="NumericUpDown.Integer">
			<Setter Property="Minimum"
							Value="0" />
			<Setter Property="Increment"
							Value="1" />
			<Setter Property="FormatString"
							Value="N0" />
			<Setter Property="ParsingNumberStyle"
							Value="Integer, AllowThousands" />
			<Setter Property="Margin"
							Value="4" />
		</Style>
	</UserControl.Styles>
	<Grid Margin="8"
				ColumnDefinitions="*,*"
				RowDefinitions="Auto,Auto,Auto">
		<HeaderedContentControl Grid.Row="0"
														Grid.Column="0"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.SettingsControl_GeneralGroupBox_Header}"
														Margin="4">
			<Grid Margin="8"
						ColumnDefinitions="Auto,*"
						RowDefinitions="Auto,Auto,Auto,Auto,Auto">
				<CheckBox Grid.Row="0"
									Grid.ColumnSpan="2"
									Content="{x:Static p:Resources.SettingsControl_AutoSaveCheckBox_Content}"
									Margin="4"
									IsChecked="{Binding General.AutoSave}" />
				<TextBlock Grid.Row="1"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_AutoSaveIntervalTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<NumericUpDown Grid.Row="1"
											 Grid.Column="1"
											 Classes="Integer"
											 Value="{Binding General.AutoSaveInterval}" />
				<CheckBox Grid.Row="2"
									Grid.ColumnSpan="2"
									Content="{x:Static p:Resources.SettingsControl_EnableLoggingCheckBox_Content}"
									Margin="4"
									IsChecked="{Binding General.EnableLogging}" />
				<TextBlock Grid.Row="3"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_LogLevelTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<ComboBox Grid.Row="3"
									Grid.Column="1"
									Margin="4"
									HorizontalAlignment="Stretch"
									ItemsSource="{m:EnumValues {x:Type logging:LogLevel}}"
									SelectedItem="{Binding General.LogLevel}" />
				<TextBlock Grid.Row="4"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_LanguageTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<ComboBox Grid.Row="4"
									Grid.Column="1"
									Margin="4"
									HorizontalAlignment="Stretch"
									ItemsSource="{m:EnumValues {x:Type appEnums:Language}}"
									SelectedItem="{Binding General.Language}" />
			</Grid>
		</HeaderedContentControl>
		<HeaderedContentControl Grid.Row="0"
														Grid.Column="1"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.SettingsControl_DatabaseGroupBox_Header}"
														Margin="4">
			<Grid Margin="8"
						ColumnDefinitions="Auto,*"
						RowDefinitions="Auto,Auto">
				<TextBlock Grid.Row="0"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_CommandTimeoutTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<NumericUpDown Grid.Row="0"
											 Grid.Column="1"
											 Classes="Integer"
											 Value="{Binding Database.CommandTimeout}" />
				<TextBlock Grid.Row="1"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_MaxBatchSizeTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<NumericUpDown Grid.Row="1"
											 Grid.Column="1"
											 Classes="Integer"
											 Value="{Binding Database.MaxBatchSize}" />
			</Grid>
		</HeaderedContentControl>
		<HeaderedContentControl Grid.Row="1"
														Grid.ColumnSpan="2"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.SettingsControl_PathsGroupBox_Header}"
														Margin="4">
			<Grid Margin="8"
						ColumnDefinitions="Auto,*,Auto"
						RowDefinitions="Auto,Auto,Auto,Auto">
				<TextBlock Grid.Row="0"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_DataDirectoryTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="0"
								 Grid.Column="1"
								 Margin="4"
								 PlaceholderText="{Binding DataDirectoryInUse}"
								 Text="{Binding Paths.DataDirectory}" />
				<Button Grid.Row="0"
								Grid.Column="2"
								Content="{x:Static p:Resources.SettingsControl_BrowseButton_Content}"
								Margin="4"
								Padding="14,6"
								Command="{Binding BrowseDataDirectoryCommand}" />
				<TextBlock Grid.Row="1"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_LogoDirectoryTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="1"
								 Grid.Column="1"
								 Margin="4"
								 PlaceholderText="{Binding LogoDirectoryInUse}"
								 Text="{Binding Paths.LogoDirectory}" />
				<Button Grid.Row="1"
								Grid.Column="2"
								Content="{x:Static p:Resources.SettingsControl_BrowseButton_Content}"
								Margin="4"
								Padding="14,6"
								Command="{Binding BrowseLogoDirectoryCommand}" />
				<TextBlock Grid.Row="2"
									 Grid.Column="0"
									 Text="{x:Static p:Resources.SettingsControl_LogDirectoryTextBlock_Text}"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="2"
								 Grid.Column="1"
								 Margin="4"
								 PlaceholderText="{Binding LogDirectoryInUse}"
								 Text="{Binding Paths.LogDirectory}" />
				<Button Grid.Row="2"
								Grid.Column="2"
								Content="{x:Static p:Resources.SettingsControl_BrowseButton_Content}"
								Margin="4"
								Padding="14,6"
								Command="{Binding BrowseLogDirectoryCommand}" />
				<TextBlock Grid.Row="3"
									 Grid.ColumnSpan="3"
									 Text="{x:Static p:Resources.SettingsControl_PathsHintTextBlock_Text}"
									 Margin="4"
									 TextWrapping="Wrap"
									 Opacity="0.7" />
			</Grid>
		</HeaderedContentControl>
		<StackPanel Grid.Row="2"
								Grid.ColumnSpan="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="4">
			<Button Content="{x:Static p:Resources.SettingsControl_LoadSettingsButton_Content}"
							Margin="4"
							Padding="14,6"
							Command="{Binding LoadCommand}"
							IsEnabled="{Binding CanLoadSettings}" />
			<Button Content="{x:Static p:Resources.SettingsControl_SaveSettingsButton_Content}"
							Margin="4"
							Padding="14,6"
							Command="{Binding SaveCommand}"
							IsEnabled="{Binding CanSaveSettings}" />
		</StackPanel>
	</Grid>
</UserControl>