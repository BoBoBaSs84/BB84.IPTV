<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="800"
						 d:DesignHeight="450"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.DatabaseControl"
						 x:DataType="vm:DatabaseViewModel">
	<Grid Margin="8"
				ColumnDefinitions="*,*"
				RowDefinitions="Auto,Auto,*,Auto">
		<HeaderedContentControl Grid.Row="0"
														Grid.Column="0"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.DatabaseControl_DatabaseOperationsGroupBox_Header}"
														Margin="4">
			<StackPanel Margin="8">
				<Button Content="{x:Static p:Resources.DatabaseControl_CreateDatabaseButton_Content}"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Margin="4"
								Height="40"
								Command="{Binding CreateDatabaseCommand}" />
				<Button Content="{x:Static p:Resources.DatabaseControl_CheckDatabaseButton_Content}"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Margin="4"
								Height="40"
								Command="{Binding CheckDatabaseCommand}" />
				<Button Content="{x:Static p:Resources.DatabaseControl_SynchronizeDatabaseButton_Content}"
								ToolTip.Tip="{x:Static p:Resources.DatabaseControl_SynchronizeDatabaseButton_ToolTip}"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								Margin="4"
								Height="40"
								Command="{Binding SynchronizeDatabaseCommand}" />
			</StackPanel>
		</HeaderedContentControl>
		<HeaderedContentControl Grid.Row="0"
														Grid.Column="1"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.DatabaseControl_DatabaseStatusGroupBox_Header}"
														Margin="4">
			<StackPanel Margin="8">
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseCreatedCheckBox_Content}"
									IsChecked="{Binding DatabaseCreated, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseCreatingCheckBox_Content}"
									IsChecked="{Binding DatabaseCreating, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseCheckedCheckBox_Content}"
									IsChecked="{Binding DatabaseChecked, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseCheckingCheckBox_Content}"
									IsChecked="{Binding DatabaseChecking, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseSynchronizedCheckBox_Content}"
									IsChecked="{Binding DatabaseSynchronized, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox Content="{x:Static p:Resources.DatabaseControl_DatabaseSynchronizingCheckBox_Content}"
									IsChecked="{Binding DatabaseSynchronizing, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
			</StackPanel>
		</HeaderedContentControl>
		<HeaderedContentControl Grid.Row="1"
														Grid.ColumnSpan="2"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.DatabaseControl_SyncProgressGroupBox_Header}"
														Margin="4">
			<StackPanel Margin="8">
				<ProgressBar Height="22"
										 Margin="4"
										 Minimum="0"
										 Maximum="{Binding SyncProgressMaximum}"
										 Value="{Binding SyncProgress}" />
				<TextBlock Text="{Binding SyncStatusMessage}"
									 Margin="4" />
			</StackPanel>
		</HeaderedContentControl>
		<!-- What was imported when, one row per list of the catalog. -->
		<HeaderedContentControl Grid.Row="2"
														Grid.ColumnSpan="2"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.DatabaseControl_CatalogStatusGroupBox_Header}"
														Margin="4">
			<DataGrid x:Name="CatalogStatusDataGrid"
								Margin="8"
								MinHeight="160"
								AutoGenerateColumns="False"
								IsReadOnly="True"
								SelectionMode="Single"
								GridLinesVisibility="All"
								ItemsSource="{Binding CatalogStatuses}">
				<DataGrid.Columns>
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_CatalogKindColumn_Header}"
															Binding="{Binding Kind}"
															Width="*" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_FirstImportedColumn_Header}"
															Binding="{Binding FirstImported}"
															Width="*" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_LastCheckedColumn_Header}"
															Binding="{Binding LastChecked}"
															Width="*" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_LastChangedColumn_Header}"
															Binding="{Binding LastChanged}"
															Width="*" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_AddedColumn_Header}"
															Binding="{Binding Added}"
															Width="80" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_UpdatedColumn_Header}"
															Binding="{Binding Updated}"
															Width="80" />
					<DataGridTextColumn x:DataType="vm:CatalogStatusItemViewModel"
															Header="{x:Static p:Resources.DatabaseControl_RemovedColumn_Header}"
															Binding="{Binding Removed}"
															Width="80" />
				</DataGrid.Columns>
			</DataGrid>
		</HeaderedContentControl>
		<!-- The logo cache: the files a playlist is shown and exported with. -->
		<HeaderedContentControl Grid.Row="3"
														Grid.ColumnSpan="2"
														Theme="{StaticResource GroupBox}"
														Header="{x:Static p:Resources.DatabaseControl_LogoCacheGroupBox_Header}"
														Margin="4">
			<StackPanel Margin="8">
				<StackPanel Orientation="Horizontal"
										Spacing="4"
										Margin="4">
					<Button Content="{x:Static p:Resources.DatabaseControl_DownloadLogosButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.DatabaseControl_DownloadLogosButton_ToolTip}"
									Command="{Binding CacheLogosCommand}" />
					<Button Content="{x:Static p:Resources.DatabaseControl_CancelLogoCacheButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.DatabaseControl_CancelLogoCacheButton_ToolTip}"
									Command="{Binding CancelLogoCacheCommand}" />
					<Button Content="{x:Static p:Resources.DatabaseControl_ClearLogoCacheButton_Content}"
									ToolTip.Tip="{x:Static p:Resources.DatabaseControl_ClearLogoCacheButton_ToolTip}"
									Command="{Binding ClearLogoCacheCommand}" />
					<TextBlock Text="{Binding LogoCacheMissingMessage}"
										 Foreground="#888"
										 VerticalAlignment="Center"
										 Margin="8,0,0,0" />
				</StackPanel>
				<ProgressBar Height="22"
										 Margin="4"
										 Minimum="0"
										 Maximum="100"
										 Value="{Binding LogoProgress}" />
				<TextBlock Text="{Binding LogoStatusMessage}"
									 Margin="4" />
			</StackPanel>
		</HeaderedContentControl>
	</Grid>
</UserControl>