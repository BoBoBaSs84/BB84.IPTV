<UserControl x:Class="BB84.IPTV.M3U.Editor.Controls.SettingsControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:sys="clr-namespace:System;assembly=mscorlib"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:behaviors="clr-namespace:BB84.IPTV.M3U.Editor.Behaviors"
						 xmlns:appEnums="clr-namespace:BB84.IPTV.M3U.Editor.Application.Enumerators;assembly=BB84.IPTV.M3U.Editor.Application"
						 xmlns:logging="clr-namespace:Microsoft.Extensions.Logging;assembly=Microsoft.Extensions.Logging.Abstractions"
						 xmlns:vm="clr-namespace:BB84.IPTV.M3U.Editor.Application.ViewModels;assembly=BB84.IPTV.M3U.Editor.Application"
						 d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
						 mc:Ignorable="d"
						 d:Background="#F0F0F0"
						 d:DesignHeight="450"
						 d:DesignWidth="800">
	<UserControl.Resources>
		<ObjectDataProvider x:Key="LanguageValues"
												MethodName="GetValues"
												ObjectType="{x:Type sys:Enum}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="appEnums:Language" />
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
		<ObjectDataProvider x:Key="LogLevelValues"
												MethodName="GetValues"
												ObjectType="{x:Type sys:Enum}">
			<ObjectDataProvider.MethodParameters>
				<x:Type TypeName="logging:LogLevel" />
			</ObjectDataProvider.MethodParameters>
		</ObjectDataProvider>
	</UserControl.Resources>
	<Grid Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<GroupBox x:Name="GeneralGroupBox"
							Grid.Row="0"
							Grid.Column="0"
							Header="General"
							Margin="4">
			<Grid Margin="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<CheckBox x:Name="AutoSaveCheckBox"
									Grid.Row="0"
									Grid.ColumnSpan="2"
									Content="Auto Save"
									Margin="4"
									IsChecked="{Binding General.AutoSave, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock x:Name="AutoSaveIntervalTextBlock"
									 Grid.Row="1"
									 Grid.Column="0"
									 Text="Auto Save Interval (min):"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="1"
								 Grid.Column="1"
								 Margin="4"
								 behaviors:IntegerTextBoxBehavior.IsEnabled="True"
								 Text="{Binding General.AutoSaveInterval, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" />
				<CheckBox x:Name="EnableLoggingCheckBox"
									Grid.Row="2"
									Grid.ColumnSpan="2"
									Content="Enable Logging"
									Margin="4"
									IsChecked="{Binding General.EnableLogging, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock x:Name="LogLevelTextBlock"
									 Grid.Row="3"
									 Grid.Column="0"
									 Text="Log Level:"
									 Margin="4"
									 VerticalAlignment="Center" />
				<ComboBox Grid.Row="3"
									Grid.Column="1"
									Margin="4"
									ItemsSource="{Binding Source={StaticResource LogLevelValues}}"
									SelectedItem="{Binding General.LogLevel, UpdateSourceTrigger=PropertyChanged}" />
				<TextBlock x:Name="LanguageTextBlock"
									 Grid.Row="4"
									 Grid.Column="0"
									 Text="Language:"
									 Margin="4"
									 VerticalAlignment="Center" />
				<ComboBox Grid.Row="4"
									Grid.Column="1"
									Margin="4"
									ItemsSource="{Binding Source={StaticResource LanguageValues}}"
									SelectedItem="{Binding General.Language, UpdateSourceTrigger=PropertyChanged}" />
			</Grid>
		</GroupBox>
		<GroupBox x:Name="DatabaseGroupBox"
							Grid.Row="0"
							Grid.Column="1"
							Header="Database"
							Margin="4">
			<Grid Margin="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock x:Name="CommandTimeoutTextBlock"
									 Grid.Row="0"
									 Grid.Column="0"
									 Text="Command Timeout (sec):"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="0"
								 Grid.Column="1"
								 Margin="4"
								 behaviors:IntegerTextBoxBehavior.IsEnabled="True"
								 Text="{Binding Database.CommandTimeout, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" />
				<TextBlock x:Name="MaxBatchSizeTextBlock"
									 Grid.Row="1"
									 Grid.Column="0"
									 Text="Max Batch Size:"
									 Margin="4"
									 VerticalAlignment="Center" />
				<TextBox Grid.Row="1"
								 Grid.Column="1"
								 Margin="4"
								 behaviors:IntegerTextBoxBehavior.IsEnabled="True"
								 Text="{Binding Database.MaxBatchSize, StringFormat={}{0:N0}, UpdateSourceTrigger=LostFocus}" />
			</Grid>
		</GroupBox>
		<StackPanel Grid.Row="1"
								Grid.ColumnSpan="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="4">
			<Button x:Name="LoadSettingsButton"
							Content="Load Settings"
							Margin="4"
							Padding="14,6"
							Command="{Binding LoadCommand}"
							IsEnabled="{Binding CanLoadSettings}" />
			<Button x:Name="SaveSettingsButton"
							Content="Save Settings"
							Margin="4"
							Padding="14,6"
							Command="{Binding SaveCommand}"
							IsEnabled="{Binding CanSaveSettings}" />
		</StackPanel>
	</Grid>
</UserControl>
