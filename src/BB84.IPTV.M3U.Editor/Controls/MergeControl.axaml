<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
						 xmlns:conv="using:BB84.IPTV.M3U.Editor.Converters"
						 xmlns:m="using:BB84.IPTV.M3U.Editor.Markup"
						 xmlns:enums="using:BB84.IPTV.M3U.Editor.Application.Enumerators"
						 xmlns:models="using:BB84.IPTV.M3U.Editor.Domain.Abstractions.Models"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="1200"
						 d:DesignHeight="700"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.MergeControl"
						 x:DataType="vm:MergeViewModel">
	<UserControl.Styles>
		<Style Selector="Grid.Detail > TextBlock">
			<Setter Property="Margin"
							Value="4" />
			<Setter Property="VerticalAlignment"
							Value="Center" />
		</Style>
		<Style Selector="Grid.Detail > TextBox">
			<Setter Property="Margin"
							Value="4" />
		</Style>
	</UserControl.Styles>
	<Grid ColumnDefinitions="320,*">
		<!-- Sources and options -->
		<ScrollViewer Grid.Column="0"
									VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="4">
				<HeaderedContentControl Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.MergeControl_SourcesGroupBox_Header}"
																Margin="4">
					<DockPanel>
						<UniformGrid DockPanel.Dock="Bottom"
												 Columns="2"
												 Margin="0,4,0,0">
							<Button Content="{x:Static p:Resources.MergeControl_MoveUpButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.MergeControl_MoveUpButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding MoveUpCommand}" />
							<Button Content="{x:Static p:Resources.MergeControl_MoveDownButton_Content}"
											ToolTip.Tip="{x:Static p:Resources.MergeControl_MoveDownButton_ToolTip}"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Center"
											Margin="2"
											Command="{Binding MoveDownCommand}" />
						</UniformGrid>
						<ListBox Height="240"
										 ItemsSource="{Binding Sources}"
										 SelectionMode="Single"
										 SelectedItem="{Binding SelectedSource}">
							<ListBox.Styles>
								<!-- Screen readers announce the playlist name instead of the view model type. -->
								<Style Selector="ListBoxItem"
											 x:DataType="vm:MergeSourceViewModel">
									<Setter Property="AutomationProperties.Name"
													Value="{Binding Name}" />
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="vm:MergeSourceViewModel">
									<CheckBox IsChecked="{Binding IsSelected}">
										<StackPanel>
											<TextBlock Text="{Binding Name}"
																 FontWeight="SemiBold"
																 TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding EntryCount, Converter={x:Static conv:ResourceFormatConverter.Instance}, ConverterParameter={x:Static p:Resources.Common_EntryCount_Format}}"
																 FontSize="12"
																 Foreground="#888" />
										</StackPanel>
									</CheckBox>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</HeaderedContentControl>

				<HeaderedContentControl Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.MergeControl_OptionsGroupBox_Header}"
																Margin="4">
					<Grid Classes="Detail"
								ColumnDefinitions="Auto,*"
								RowDefinitions="Auto,Auto,Auto">
						<TextBlock Grid.Row="0"
											 Text="{x:Static p:Resources.MergeControl_NameTextBlock_Text}" />
						<TextBox Grid.Row="0"
										 Grid.Column="1"
										 Text="{Binding Name}" />

						<TextBlock Grid.Row="1"
											 Text="{x:Static p:Resources.MergeControl_DuplicateModeTextBlock_Text}"
											 ToolTip.Tip="{x:Static p:Resources.MergeControl_DuplicateModeTextBlock_ToolTip}" />
						<ComboBox Grid.Row="1"
											Grid.Column="1"
											Margin="4"
											HorizontalAlignment="Stretch"
											ItemsSource="{m:EnumValues {x:Type enums:MergeDuplicateMode}}"
											SelectedItem="{Binding DuplicateMode}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="enums:MergeDuplicateMode">
									<TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayNameConverter.Instance}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<TextBlock Grid.Row="2"
											 Text="{x:Static p:Resources.MergeControl_DuplicateResolutionTextBlock_Text}"
											 ToolTip.Tip="{x:Static p:Resources.MergeControl_DuplicateResolutionTextBlock_ToolTip}" />
						<ComboBox Grid.Row="2"
											Grid.Column="1"
											Margin="4"
											HorizontalAlignment="Stretch"
											ItemsSource="{m:EnumValues {x:Type enums:MergeDuplicateResolution}}"
											SelectedItem="{Binding DuplicateResolution}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="enums:MergeDuplicateResolution">
									<TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayNameConverter.Instance}}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>
				</HeaderedContentControl>

				<!-- Group remapping, filled by a preview -->
				<HeaderedContentControl Theme="{StaticResource GroupBox}"
																Header="{x:Static p:Resources.MergeControl_GroupsGroupBox_Header}"
																Margin="4"
																IsVisible="{Binding HasPreview}">
					<StackPanel>
						<TextBlock Text="{x:Static p:Resources.MergeControl_GroupsHint_Text}"
											 Foreground="#888"
											 TextWrapping="Wrap"
											 Margin="4" />
						<DataGrid MaxHeight="220"
											AutoGenerateColumns="False"
											CanUserSortColumns="True"
											GridLinesVisibility="All"
											ItemsSource="{Binding GroupMappings}">
							<DataGrid.Columns>
								<DataGridTextColumn x:DataType="vm:MergeGroupMappingViewModel"
																		Header="{x:Static p:Resources.MergeControl_GroupColumn_Header}"
																		Binding="{Binding SourceGroup}"
																		IsReadOnly="True"
																		Width="*" />
								<DataGridTextColumn x:DataType="vm:MergeGroupMappingViewModel"
																		Header="{x:Static p:Resources.MergeControl_TargetGroupColumn_Header}"
																		Binding="{Binding TargetGroup}"
																		Width="*" />
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</HeaderedContentControl>
			</StackPanel>
		</ScrollViewer>

		<!-- Preview -->
		<DockPanel Grid.Column="1">
			<StackPanel DockPanel.Dock="Top"
									Orientation="Horizontal"
									Spacing="4"
									Margin="4">
				<Button Content="{x:Static p:Resources.MergeControl_PreviewButton_Content}"
								ToolTip.Tip="{x:Static p:Resources.MergeControl_PreviewButton_ToolTip}"
								Command="{Binding PreviewCommand}" />
				<Button Content="{x:Static p:Resources.MergeControl_MergeButton_Content}"
								ToolTip.Tip="{x:Static p:Resources.MergeControl_MergeButton_ToolTip}"
								Command="{Binding MergeCommand}" />
				<TextBlock Text="{Binding PreviewMessage}"
									 Foreground="#888"
									 VerticalAlignment="Center"
									 Margin="8,0,0,0" />
			</StackPanel>

			<!-- Why the merge cannot run -->
			<Border DockPanel.Dock="Top"
							Background="#FDECEA"
							BorderBrush="#F5C2C0"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,4"
							Margin="4,0"
							IsVisible="{Binding !IsValid}">
				<TextBlock Text="{Binding ValidationMessage}"
									 Foreground="#A4262C"
									 TextWrapping="Wrap" />
			</Border>

			<HeaderedContentControl Theme="{StaticResource GroupBox}"
															Header="{x:Static p:Resources.MergeControl_PreviewGroupBox_Header}"
															Margin="4">
				<DataGrid AutoGenerateColumns="False"
									IsReadOnly="True"
									CanUserSortColumns="True"
									SelectionMode="Single"
									GridLinesVisibility="All"
									ItemsSource="{Binding PreviewEntries}">
					<DataGrid.Columns>
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.MergeControl_TitleColumn_Header}"
																Binding="{Binding Title}"
																Width="2*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.MergeControl_GroupColumn_Header}"
																Binding="{Binding Metadata.GroupTitle}"
																Width="*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.MergeControl_TvgIdColumn_Header}"
																Binding="{Binding Metadata.TvgId}"
																Width="*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.MergeControl_UrlColumn_Header}"
																Binding="{Binding FilePath}"
																Width="2*" />
					</DataGrid.Columns>
				</DataGrid>
			</HeaderedContentControl>
		</DockPanel>
	</Grid>
</UserControl>