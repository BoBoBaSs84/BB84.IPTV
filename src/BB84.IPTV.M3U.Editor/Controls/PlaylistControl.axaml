<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:m="using:BB84.IPTV.M3U.Editor.Markup"
						 xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
						 xmlns:domain="using:BB84.IPTV.M3U.Editor.Domain.Enumerators"
						 xmlns:conv="using:BB84.IPTV.M3U.Editor.Converters"
						 xmlns:models="using:BB84.IPTV.M3U.Editor.Domain.Abstractions.Models"
						 xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
						 mc:Ignorable="d"
						 d:DesignWidth="1000"
						 d:DesignHeight="600"
						 x:Class="BB84.IPTV.M3U.Editor.Controls.PlaylistControl"
						 x:DataType="vm:PlaylistViewModel">
	<UserControl.Styles>
		<Style Selector="Grid.Detail > TextBlock">
			<Setter Property="Margin"
							Value="4" />
			<Setter Property="VerticalAlignment"
							Value="Center" />
		</Style>
		<Style Selector="Grid.Detail > TextBox">
			<Setter Property="Margin"
							Value="4" />
		</Style>
	</UserControl.Styles>
	<DockPanel>
		<!-- Toolbar -->
		<StackPanel DockPanel.Dock="Top"
								Orientation="Horizontal"
								Spacing="4"
								Margin="4">
			<Button Content="{x:Static p:Resources.PlaylistControl_AddButton_Content}"
							ToolTip.Tip="{x:Static p:Resources.PlaylistControl_AddButton_ToolTip}"
							Click="AddButton_Click" />
			<Button Content="{x:Static p:Resources.PlaylistControl_DuplicateButton_Content}"
							ToolTip.Tip="{x:Static p:Resources.PlaylistControl_DuplicateButton_ToolTip}"
							Click="DuplicateButton_Click" />
			<Button Content="{x:Static p:Resources.PlaylistControl_RemoveButton_Content}"
							ToolTip.Tip="{x:Static p:Resources.PlaylistControl_RemoveButton_ToolTip}"
							Click="RemoveButton_Click" />
			<Button Content="{x:Static p:Resources.PlaylistControl_MoveUpButton_Content}"
							ToolTip.Tip="{x:Static p:Resources.PlaylistControl_MoveUpButton_ToolTip}"
							IsEnabled="{Binding CanReorderEntries}"
							Click="MoveUpButton_Click" />
			<Button Content="{x:Static p:Resources.PlaylistControl_MoveDownButton_Content}"
							ToolTip.Tip="{x:Static p:Resources.PlaylistControl_MoveDownButton_ToolTip}"
							IsEnabled="{Binding CanReorderEntries}"
							Click="MoveDownButton_Click" />
			<TextBlock Text="{x:Static p:Resources.PlaylistControl_DirtyHint_Text}"
								 Foreground="#888"
								 VerticalAlignment="Center"
								 Margin="12,0,0,0"
								 IsVisible="{Binding IsDirty}" />
		</StackPanel>

		<!-- Why the playlist cannot be saved -->
		<Border DockPanel.Dock="Top"
						Background="#FDECEA"
						BorderBrush="#F5C2C0"
						BorderThickness="1"
						CornerRadius="4"
						Padding="8,4"
						Margin="4,0"
						IsVisible="{Binding !IsValid}">
			<TextBlock Text="{Binding ValidationMessage}"
								 Foreground="#A4262C"
								 TextWrapping="Wrap" />
		</Border>

		<Grid ColumnDefinitions="*,Auto">
			<!-- Entries DataGrid -->
			<HeaderedContentControl Grid.Column="0"
															Theme="{StaticResource GroupBox}"
															Header="{x:Static p:Resources.PlaylistControl_EntriesGroupBox_Header}"
															Margin="4">
				<DataGrid x:Name="EntriesDataGrid"
									AutoGenerateColumns="False"
									IsReadOnly="False"
									CanUserSortColumns="True"
									SelectionMode="Single"
									GridLinesVisibility="All"
									ItemsSource="{Binding Entries}"
									SelectedItem="{Binding SelectedEntry}"
									Sorting="OnEntriesSorting">
					<DataGrid.Columns>
						<!-- Only cached logos are shown, a missing one stays empty. -->
						<DataGridTemplateColumn Header="{x:Static p:Resources.PlaylistControl_LogoColumn_Header}"
																		Width="56"
																		IsReadOnly="True">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="models:IEntry">
									<Image Source="{Binding Metadata.TvgLogo, Converter={x:Static conv:LogoImageConverter.Instance}}"
												 Height="32"
												 Width="48"
												 Stretch="Uniform"
												 Margin="2" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.PlaylistControl_TitleColumn_Header}"
																Binding="{Binding Title}"
																Width="2*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.PlaylistControl_GroupColumn_Header}"
																Binding="{Binding Metadata.GroupTitle}"
																Width="*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.PlaylistControl_TvgIdColumn_Header}"
																Binding="{Binding Metadata.TvgId}"
																Width="*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.PlaylistControl_TvgNameColumn_Header}"
																Binding="{Binding Metadata.TvgName}"
																Width="*" />
						<DataGridTextColumn x:DataType="models:IEntry"
																Header="{x:Static p:Resources.PlaylistControl_UrlColumn_Header}"
																Binding="{Binding FilePath}"
																Width="2*" />
					</DataGrid.Columns>
				</DataGrid>
			</HeaderedContentControl>

			<!-- Detail Panel -->
			<ScrollViewer Grid.Column="1"
										VerticalScrollBarVisibility="Auto"
										Width="320">
				<StackPanel Margin="4"
										Spacing="4">
					<!-- Playlist Header -->
					<HeaderedContentControl Theme="{StaticResource GroupBox}"
																	Header="{x:Static p:Resources.PlaylistControl_PlaylistGroupBox_Header}">
						<Grid Classes="Detail"
									ColumnDefinitions="Auto,*"
									RowDefinitions="Auto,Auto,Auto,Auto,Auto">
							<TextBlock Grid.Row="0"
												 Text="{x:Static p:Resources.PlaylistControl_NameTextBlock_Text}" />
							<TextBox Grid.Row="0"
											 Grid.Column="1"
											 Text="{Binding Name}" />

							<TextBlock Grid.Row="1"
												 Text="{x:Static p:Resources.PlaylistControl_TvGuideTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Playlist_TVGuidePath}" />
							<TextBox Grid.Row="1"
											 Grid.Column="1"
											 Text="{Binding UrlTvg}" />

							<TextBlock Grid.Row="2"
												 Text="{x:Static p:Resources.PlaylistControl_CacheTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Playlist_Cache}" />
							<TextBox Grid.Row="2"
											 Grid.Column="1"
											 Text="{Binding Cache}" />

							<TextBlock Grid.Row="3"
												 Text="{x:Static p:Resources.PlaylistControl_DeinterlaceTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Playlist_Deinterlace}" />
							<ComboBox Grid.Row="3"
												Grid.Column="1"
												Margin="4"
												HorizontalAlignment="Stretch"
												ItemsSource="{m:EnumValues {x:Type domain:Deinterlace}}"
												SelectedItem="{Binding Deinterlace}">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="domain:Deinterlace">
										<TextBlock Text="{Binding Converter={x:Static conv:EnumDisplayNameConverter.Instance}}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Grid.Row="4"
												 Text="{x:Static p:Resources.PlaylistControl_RefreshTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Playlist_Refresh}" />
							<TextBox Grid.Row="4"
											 Grid.Column="1"
											 Text="{Binding Refresh}" />
						</Grid>
					</HeaderedContentControl>

					<!-- Entry Detail -->
					<HeaderedContentControl Theme="{StaticResource GroupBox}"
																	Header="{x:Static p:Resources.PlaylistControl_EntryGroupBox_Header}"
																	IsVisible="{Binding SelectedEntryVisible}">
						<Grid Classes="Detail"
									DataContext="{Binding SelectedEntry}"
									x:DataType="models:IEntry"
									ColumnDefinitions="Auto,*"
									RowDefinitions="Auto,Auto,Auto,Auto">
							<TextBlock Grid.Row="0"
												 Text="{x:Static p:Resources.PlaylistControl_DurationTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Track_Duration}" />
							<TextBox Grid.Row="0"
											 Grid.Column="1"
											 Text="{Binding Duration}" />

							<TextBlock Grid.Row="1"
												 Text="{x:Static p:Resources.PlaylistControl_TitleTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Track_Title}" />
							<TextBox Grid.Row="1"
											 Grid.Column="1"
											 Text="{Binding Title}" />

							<TextBlock Grid.Row="2"
												 Text="{x:Static p:Resources.PlaylistControl_LocationTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Track_Location}" />
							<TextBox Grid.Row="2"
											 Grid.Column="1"
											 Text="{Binding FilePath}" />

							<TextBlock Grid.Row="3"
												 Text="{x:Static p:Resources.PlaylistControl_GroupingTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Track_Grouping}" />
							<TextBox Grid.Row="3"
											 Grid.Column="1"
											 Text="{Binding Grouping}" />
						</Grid>
					</HeaderedContentControl>

					<!-- Metadata Detail -->
					<HeaderedContentControl Theme="{StaticResource GroupBox}"
																	Header="{x:Static p:Resources.PlaylistControl_MetadataGroupBox_Header}"
																	IsVisible="{Binding SelectedEntryVisible}">
						<Grid Classes="Detail"
									DataContext="{Binding SelectedEntry}"
									x:DataType="models:IEntry"
									ColumnDefinitions="Auto,*"
									RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
							<TextBlock Grid.Row="0"
												 Text="{x:Static p:Resources.PlaylistControl_TvgIdTextBlock_Text}" />
							<TextBox Grid.Row="0"
											 Grid.Column="1"
											 Text="{Binding Metadata.TvgId}" />

							<TextBlock Grid.Row="1"
												 Text="{x:Static p:Resources.PlaylistControl_TvgNameTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Metadata_Name}" />
							<TextBox Grid.Row="1"
											 Grid.Column="1"
											 Text="{Binding Metadata.TvgName}" />

							<TextBlock Grid.Row="2"
												 Text="{x:Static p:Resources.PlaylistControl_TvgLogoTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Metadata_Logo}" />
							<TextBox Grid.Row="2"
											 Grid.Column="1"
											 Text="{Binding Metadata.TvgLogo}" />

							<TextBlock Grid.Row="3"
												 Text="{x:Static p:Resources.PlaylistControl_GroupIdTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Metadata_GroupId}" />
							<TextBox Grid.Row="3"
											 Grid.Column="1"
											 Text="{Binding Metadata.GroupId}" />

							<TextBlock Grid.Row="4"
												 Text="{x:Static p:Resources.PlaylistControl_GroupTitleTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Metadata_GroupTitle}" />
							<TextBox Grid.Row="4"
											 Grid.Column="1"
											 Text="{Binding Metadata.GroupTitle}" />

							<CheckBox Grid.Row="5"
												Grid.ColumnSpan="2"
												Content="{x:Static p:Resources.PlaylistControl_CensoredCheckBox_Content}"
												Margin="4"
												ToolTip.Tip="{x:Static p:Resources.ToolTip_Metadata_Censored}"
												IsChecked="{Binding Metadata.Censored}" />
						</Grid>
					</HeaderedContentControl>

					<!-- The file the logo of the entry stands for, and where another logo comes from -->
					<HeaderedContentControl Theme="{StaticResource GroupBox}"
															Header="{x:Static p:Resources.LogoOverviewControl_LogoColumn_Header}"
															IsVisible="{Binding SelectedEntryVisible}">
						<StackPanel Margin="8"
												Spacing="4">
							<Image Source="{Binding SelectedEntryLogoPath, Converter={x:Static conv:LogoImageConverter.Instance}}"
											 Height="64"
											 Stretch="Uniform" />
							<TextBlock Text="{x:Static p:Resources.PlaylistControl_LogoPathTextBlock_Text}"
												 ToolTip.Tip="{x:Static p:Resources.ToolTip_Logo_CachedFile}" />
							<TextBox Text="{Binding SelectedEntryLogoPath, Mode=OneWay}"
											 IsReadOnly="True"
											 ToolTip.Tip="{x:Static p:Resources.ToolTip_Logo_CachedFile}" />
							<UniformGrid Columns="2">
								<Button Content="{x:Static p:Resources.PlaylistControl_BrowseLogoButton_Content}"
												ToolTip.Tip="{x:Static p:Resources.PlaylistControl_BrowseLogoButton_ToolTip}"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Center"
												Margin="0,0,2,0"
												Click="BrowseLogoButton_Click" />
								<Button Content="{x:Static p:Resources.PlaylistControl_CopyLogoPathButton_Content}"
												ToolTip.Tip="{x:Static p:Resources.PlaylistControl_CopyLogoPathButton_ToolTip}"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Center"
												Margin="2,0,0,0"
												Click="CopyLogoPathButton_Click" />
							</UniformGrid>
						</StackPanel>
					</HeaderedContentControl>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</UserControl>