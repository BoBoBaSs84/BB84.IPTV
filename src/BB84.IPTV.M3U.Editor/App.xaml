<Application x:Class="BB84.IPTV.M3U.Editor.App"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:vm="clr-namespace:BB84.IPTV.M3U.Editor.Application.ViewModels;assembly=BB84.IPTV.M3U.Editor.Application"
						 xmlns:v="clr-namespace:BB84.IPTV.M3U.Editor.Controls"
						 Startup="Application_Startup"
						 Exit="Application_Exit">
	<Application.Resources>
		<DropShadowEffect x:Key="CardShadow"
											BlurRadius="20"
											ShadowDepth="2"
											Opacity="0.15"
											Color="Black" />
		<DataTemplate DataType="{x:Type TypeName=vm:AboutViewModel}">
			<v:AboutControl />
		</DataTemplate>
		<DataTemplate DataType="{x:Type TypeName=vm:DatabaseViewModel}">
			<v:DatabaseControl />
		</DataTemplate>
		<DataTemplate DataType="{x:Type TypeName=vm:PlaylistViewModel}">
			<v:PlaylistControl />
		</DataTemplate>
		<DataTemplate DataType="{x:Type TypeName=vm:SettingsViewModel}">
			<v:SettingsControl />
		</DataTemplate>
	</Application.Resources>
</Application>
