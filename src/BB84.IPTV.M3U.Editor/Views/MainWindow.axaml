<Window xmlns="https://github.com/avaloniaui"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:p="using:BB84.IPTV.M3U.Editor.Properties"
				xmlns:vm="using:BB84.IPTV.M3U.Editor.Application.ViewModels"
				mc:Ignorable="d"
				d:DesignWidth="1280"
				d:DesignHeight="720"
				x:Class="BB84.IPTV.M3U.Editor.Views.MainWindow"
				x:DataType="vm:MainViewModel"
				Icon="/Application.ico"
				Title="{Binding ApplicationTitle}"
				Width="1280"
				Height="720"
				WindowStartupLocation="CenterScreen">
	<DockPanel>
		<!-- Menu Bar -->
		<Menu DockPanel.Dock="Top">
			<MenuItem x:Name="FileMenuItem"
								Header="{x:Static p:Resources.MainWindow_FileMenuItem_Header}"
								SubmenuOpened="FileMenuItem_SubmenuOpened">
				<MenuItem x:Name="NewMenuItem"
									Header="{x:Static p:Resources.MainWindow_NewMenuItem_Header}"
									InputGesture="Ctrl+N"
									HotKey="Ctrl+N">
					<MenuItem.Icon>
						<Image Source="/Resources/document.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem x:Name="ImportMenuItem"
									Header="{x:Static p:Resources.MainWindow_ImportMenuItem_Header}"
									InputGesture="Ctrl+O"
									HotKey="Ctrl+O">
					<MenuItem.Icon>
						<Image Source="/Resources/folder_document.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem x:Name="SaveMenuItem"
									Header="{x:Static p:Resources.MainWindow_SaveMenuItem_Header}"
									InputGesture="Ctrl+S"
									HotKey="Ctrl+S">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disk.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem x:Name="ExportMenuItem"
									Header="{x:Static p:Resources.MainWindow_ExportMenuItem_Header}">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disk_edit.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem x:Name="MergeMenuItem"
									Header="{x:Static p:Resources.MainWindow_MergeMenuItem_Header}">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disks.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem Header="{x:Static p:Resources.MainWindow_PrintMenuItem_Header}"
									InputGesture="Ctrl+P">
					<MenuItem.Icon>
						<Image Source="/Resources/printer.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_PrintPreviewMenuItem_Header}">
					<MenuItem.Icon>
						<Image Source="/Resources/document_view.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem Header="{x:Static p:Resources.MainWindow_ExitMenuItem_Header}"
									Command="{Binding ExitApplicationCommand}">
					<MenuItem.Icon>
						<Image Source="/Resources/exit.ico" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{x:Static p:Resources.MainWindow_EditMenuItem_Header}">
				<MenuItem Header="{x:Static p:Resources.MainWindow_UndoMenuItem_Header}"
									InputGesture="Ctrl+Z" />
				<MenuItem Header="{x:Static p:Resources.MainWindow_RedoMenuItem_Header}"
									InputGesture="Ctrl+Y" />
				<Separator />
				<MenuItem Header="{x:Static p:Resources.MainWindow_CutMenuItem_Header}"
									InputGesture="Ctrl+X" />
				<MenuItem Header="{x:Static p:Resources.MainWindow_CopyMenuItem_Header}"
									InputGesture="Ctrl+C" />
				<MenuItem Header="{x:Static p:Resources.MainWindow_PasteMenuItem_Header}"
									InputGesture="Ctrl+V" />
				<Separator />
				<MenuItem Header="{x:Static p:Resources.MainWindow_SelectAllMenuItem_Header}" />
			</MenuItem>
			<MenuItem Header="{x:Static p:Resources.MainWindow_ToolsMenuItem_Header}">
				<MenuItem Header="{x:Static p:Resources.MainWindow_PlaylistsMenuItem_Header}"
									Click="PlaylistsMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/document_music.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_MergePlaylistsMenuItem_Header}"
									Click="MergeMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/documents_exchange.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_CatalogMenuItem_Header}"
									Click="CatalogMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/tv.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_GuideMenuItem_Header}"
									Click="GuideMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/document_refresh.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_GuideOverviewMenuItem_Header}"
									Click="GuideOverviewMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/book_blue_open2.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_LogoOverviewMenuItem_Header}"
									Click="LogoOverviewMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/photo_landscape.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_DatabaseMenuItem_Header}"
									Click="DatabaseMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/data.ico" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="{x:Static p:Resources.MainWindow_SettingsMenuItem_Header}"
									Command="{Binding OpenSettingsCommand}">
					<MenuItem.Icon>
						<Image Source="/Resources/gear.ico" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="{x:Static p:Resources.MainWindow_HelpMenuItem_Header}">
				<MenuItem Header="{x:Static p:Resources.MainWindow_IndexMenuItem_Header}" />
				<MenuItem Header="{x:Static p:Resources.MainWindow_SearchMenuItem_Header}" />
				<Separator />
				<MenuItem Header="{x:Static p:Resources.MainWindow_AboutMenuItem_Header}"
									Command="{Binding ShowAboutControl}">
					<MenuItem.Icon>
						<Image Source="/Resources/about.ico" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
		</Menu>

		<!-- Status Bar -->
		<Border DockPanel.Dock="Bottom"
						Background="#F0F0F0"
						BorderBrush="#D0D0D0"
						BorderThickness="0,1,0,0"
						Padding="8,3">
			<DockPanel>
				<ProgressBar DockPanel.Dock="Right"
										 Width="200"
										 Height="16"
										 MinHeight="16"
										 Minimum="{Binding ProgressBarMinimum}"
										 Maximum="{Binding ProgressBarMaximum}"
										 Value="{Binding ProgressBarValue}"
										 IsVisible="{Binding ProgressBarVisible}" />
				<TextBlock Text="{Binding StatusText}"
									 VerticalAlignment="Center" />
			</DockPanel>
		</Border>

		<!-- Main Content Area -->
		<ContentControl Content="{Binding NavigationService.CurrentView}" />
	</DockPanel>
</Window>