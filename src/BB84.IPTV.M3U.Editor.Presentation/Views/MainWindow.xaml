<Window x:Class="BB84.IPTV.M3U.Editor.Presentation.Views.MainWindow"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:vm="clr-namespace:BB84.IPTV.M3U.Editor.Application.ViewModels;assembly=BB84.IPTV.M3U.Editor.Application"
				xmlns:controls="clr-namespace:BB84.IPTV.M3U.Editor.Presentation.Controls"
				mc:Ignorable="d"
				d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
				ShowInTaskbar="True"
				Title="{Binding ApplicationTitle}"
				Height="720"
				Width="1280"
				WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</Window.Resources>
	<DockPanel>
		<!-- Menu Bar -->
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="_File">
				<MenuItem Header="_New"
									InputGestureText="Ctrl+N"
									Click="NewMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/document.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Open"
									InputGestureText="Ctrl+O"
									Click="OpenMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/folder_document.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem x:Name="saveMenuItem"
									Header="_Save"
									InputGestureText="Ctrl+S"
									Click="SaveMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disk.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem x:Name="saveAsMenuItem"
									Header="Save _As"
									Click="SaveAsMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disk_edit.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Merge"
									Click="MergeMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/floppy_disks.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem Header="_Print"
									InputGestureText="Ctrl+P">
					<MenuItem.Icon>
						<Image Source="/Resources/printer.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="Print Pre_view">
					<MenuItem.Icon>
						<Image Source="/Resources/document_view.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<Separator />
				<MenuItem Header="E_xit"
									Command="{Binding ExitApplicationCommand}">
					<MenuItem.Icon>
						<Image Source="/Resources/exit.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="_Edit">
				<MenuItem Header="_Undo"
									InputGestureText="Ctrl+Z" />
				<MenuItem Header="_Redo"
									InputGestureText="Ctrl+Y" />
				<Separator />
				<MenuItem Header="Cu_t"
									InputGestureText="Ctrl+X" />
				<MenuItem Header="_Copy"
									InputGestureText="Ctrl+C" />
				<MenuItem Header="_Paste"
									InputGestureText="Ctrl+V" />
				<Separator />
				<MenuItem Header="Select _All" />
			</MenuItem>
			<MenuItem Header="_Tools">
				<MenuItem Header="_Database"
									Click="DatabaseMenuItem_Click">
					<MenuItem.Icon>
						<Image Source="/Resources/data.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem Header="_Settings"
									Command="{Binding OpenSettingsCommand}">
					<MenuItem.Icon>
						<Image Source="/Resources/gear.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
			<MenuItem Header="_Help">
				<MenuItem Header="_Index" />
				<MenuItem Header="_Search" />
				<Separator />
				<MenuItem Header="_About..."
									Command="{Binding ShowAboutControl}">
					<MenuItem.Icon>
						<Image Source="/Resources/about.ico"
									 Width="16"
									 Height="16" />
					</MenuItem.Icon>
				</MenuItem>
			</MenuItem>
		</Menu>

		<!-- Status Bar -->
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock Text="{Binding StatusText}" />
			</StatusBarItem>
			<StatusBarItem HorizontalAlignment="Right">
				<ProgressBar x:Name="mainProgressBar"
										 Width="200"
										 Height="16"
										 Minimum="{Binding ProgressBarMinimum}"
										 Maximum="{Binding ProgressBarMaximum}"
										 Value="{Binding ProgressBarValue}"
										 Visibility="{Binding ProgressBarVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
			</StatusBarItem>
		</StatusBar>

		<!-- Main Content Area -->
		<ContentControl Content="{Binding NavigationService.CurrentView}" />
	</DockPanel>
</Window>
