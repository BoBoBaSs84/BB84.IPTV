<UserControl x:Class="BB84.IPTV.M3U.Editor.Presentation.Controls.DatabaseControl"
						 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:vm="clr-namespace:BB84.IPTV.M3U.Editor.Application.ViewModels;assembly=BB84.IPTV.M3U.Editor.Application"
						 d:DataContext="{d:DesignInstance Type=vm:DatabaseViewModel}"
						 mc:Ignorable="d"
						 d:Background="#F0F0F0"
						 d:DesignHeight="450"
						 d:DesignWidth="800">
	<Grid Margin="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<GroupBox x:Name="DatabaseOperationsGroupBox"
							Grid.Row="0"
							Grid.Column="0"
							Header="Database Operations"
							Margin="4">
			<StackPanel Margin="8">
				<Button x:Name="CreateDatabaseButton"
								Content="Create Database"
								Margin="4"
								Height="40"
								Command="{Binding CreateDatabaseCommand}" />
				<Button x:Name="CheckDatabaseButton"
								Content="Check Database"
								Margin="4"
								Height="40"
								Command="{Binding CheckDatabaseCommand}" />
				<Button x:Name="ImportDatabaseButton"
								Content="Import Database"
								Margin="4"
								Height="40"
								Command="{Binding ImportDatabaseCommand}" />
			</StackPanel>
		</GroupBox>
		<GroupBox x:Name="DatabaseStatusGroupBox"
							Grid.Row="0"
							Grid.Column="1"
							Header="Database Status"
							Margin="4">
			<StackPanel Margin="8">
				<CheckBox x:Name="DatabaseCreatedCheckBox"
									Content="Database Created"
									IsChecked="{Binding DatabaseCreated, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox x:Name="DatabaseCreatingCheckBox"
									Content="Database Creating"
									IsChecked="{Binding DatabaseCreating, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox x:Name="DatabaseCheckedCheckBox"
									Content="Database Checked"
									IsChecked="{Binding DatabaseChecked, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox x:Name="DatabaseCheckingCheckBox"
									Content="Database Checking"
									IsChecked="{Binding DatabaseChecking, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox x:Name="DatabaseImportedCheckBox"
									Content="Database Imported"
									IsChecked="{Binding DatabaseImported, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
				<CheckBox x:Name="DatabaseImportingCheckBox"
									Content="Database Importing"
									IsChecked="{Binding DatabaseImporting, Mode=OneWay}"
									IsEnabled="False"
									Margin="4" />
			</StackPanel>
		</GroupBox>
		<GroupBox x:Name="ImportProgressGroupBox"
							Grid.Row="1"
							Grid.ColumnSpan="2"
							Header="Import Progress"
							Margin="4">
			<StackPanel Margin="8">
				<ProgressBar Height="22"
										 Margin="4"
										 Minimum="0"
										 Maximum="{Binding ImportProgressMaximum, Mode=OneWay}"
										 Value="{Binding ImportProgress, Mode=OneWay}" />
				<TextBlock Text="{Binding ImportStatusMessage, Mode=OneWay}"
									 Margin="4" />
			</StackPanel>
		</GroupBox>
	</Grid>
</UserControl>
